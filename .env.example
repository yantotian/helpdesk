# Copy to .env, then edit. Required by docker-compose.yml.
# Generate a secret with:  openssl rand -base64 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")

JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Port the app is published on (host side).
APP_PORT=8080

# Database credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helpdesk

# Bootstrap sysadmin, created on first boot only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
